# Optional override for the Vantage API base URL
VITE_VANTAGE_API_BASE=https://vantage-movers-main-server.vercel.app

# Optional dev-only fallback for local sync testing against protected /api/v1 routes.
# Do not set this for production/distributed builds; users sign in at runtime.
# This value is bundled into the extension build when present.
VITE_VANTAGE_API_SECRET= 


